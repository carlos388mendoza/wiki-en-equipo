# Copia este archivo a .env.local y ajusta los valores. No subas .env.local.

# URL del backend (solo la usa el servidor de Next; el navegador nunca la llama directo).
# En producción, el mismo dominio de la wiki (un solo proyecto de Vercel): https://wiki-grupo-comidas.vercel.app
BACKEND_URL=http://localhost:4000

# Canal de avisos en tiempo real del backend (WebSocket). Si no se define,
# se usa ws://<host actual>:4000/realtime.
# NEXT_PUBLIC_REALTIME_URL=ws://localhost:4000/realtime

# Edición en vivo (Yjs) con presencia: la ofrece el backend en /collab, en el mismo puerto que la API.
# Si no se define, se usa ws://<host actual>:4000/collab (o la máquina de NEXT_PUBLIC_REALTIME_URL).
# Con wss://…/collab usa WebSockets. Con https://…/api/collab usa consultas periódicas por HTTP (producción en
# Vercel, que no comparte WebSockets entre instancias). Con "off" se desactiva y solo se usan los avisos de /realtime.
# NEXT_PUBLIC_COLLAB_URL=https://wiki-grupo-comidas.vercel.app/api/collab

# Límite de subida mostrado en la interfaz (debe coincidir con MAX_UPLOAD_BYTES del backend). En producción 20:
# los archivos de más de 3 MB se suben en partes (una petición de Vercel no acepta más de 4,5 MB).
# NEXT_PUBLIC_MAX_UPLOAD_MB=20

# Días que una página pasa en la papelera antes de borrarse (texto de la papelera; debe coincidir con
# TRASH_RETENTION_DAYS del backend).
# NEXT_PUBLIC_TRASH_RETENTION_DAYS=30

# Activa el service worker (modo sin conexión) también en desarrollo. En producción siempre está activo.
# NEXT_PUBLIC_ENABLE_SW=1

# Producción en Vercel: el mismo PROXY_SECRET del backend (solo lo usa el servidor de Next, nunca el navegador).
# PROXY_SECRET=

# Cifra la cookie de las cuentas guardadas en el dispositivo (wiki_cuentas, "Cambiar de cuenta" sin contraseña).
# Un valor aleatorio y largo (por ejemplo, 64 bytes en base64url); si cambia, las cuentas guardadas se olvidan una
# vez. Sin él se usa PROXY_SECRET; en local, sin ninguno, una clave solo de desarrollo. En Vercel: sensible.
# ACCOUNTS_SECRET=

# Búsqueda de fotos de fondo con la API de Unsplash (solo en el servidor; nunca en el navegador). Sin clave, la
# ventana de fondos busca en la galería fija. Clave gratuita: 50 búsquedas por hora. En Vercel: solo Production.
# UNSPLASH_ACCESS_KEY=
